{
  "initialize": {
    "protocolVersion": "2025-06-18",
    "serverInfo": {
      "name": "stardewpilot-bridge",
      "version": "0.1.0"
    },
    "capabilities": {
      "tools": {}
    },
    "gameVersion": "1.6.15",
    "settings": {
      "gameLanguage": "en",
      "tellMeEverything": false,
      "chattiness": "Talkative",
      "selfPlay": false
    }
  },
  "tools/list": {
    "tools": [
      {
        "name": "buy_items",
        "description": "Walk to the shop that sells an item and buy it through the shop menu. Fails if the shop is closed or the farmer cannot afford it. Large purchases ask the player first.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "item": {
              "type": "string",
              "description": "Item name, for example 'Cauliflower Seeds'."
            },
            "count": {
              "type": "integer",
              "description": "How many to buy."
            },
            "shop": {
              "type": "string",
              "description": "Optional shop id. Default: the first shop that sells it.",
              "enum": [
                "SeedShop",
                "Joja",
                "FishShop",
                "Blacksmith",
                "AnimalShop",
                "Saloon",
                "Carpenter",
                "Hospital"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "item",
            "count"
          ]
        },
        "annotations": {
          "readOnlyHint": false
        }
      },
      {
        "name": "collect_forage",
        "description": "Pick up all forage (wild plants, shells and similar) on a map, default the current one.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "location": {
              "type": "string",
              "description": "Map name. Default the current map."
            }
          },
          "additionalProperties": false
        },
        "annotations": {
          "readOnlyHint": false
        }
      },
      {
        "name": "get_bundles",
        "description": "Community Center bundles the farmer can see: each room's bundles with items still needed and items already given. Returns why if bundles are not visible yet or the farm chose Joja.",
        "inputSchema": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "annotations": {
          "readOnlyHint": true
        }
      },
      {
        "name": "get_calendar",
        "description": "This season's calendar: festivals and villager birthdays with their days, plus today's and tomorrow's events and tomorrow's weather forecast.",
        "inputSchema": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "annotations": {
          "readOnlyHint": true
        }
      },
      {
        "name": "get_crops",
        "description": "Crops planted on a map (default Farm, including garden pots): grouped by crop with counts that are ready to harvest, need water, or are dead, and the days until the next harvest. Set includeTiles for tile positions.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "location": {
              "type": "string",
              "description": "Map name. Default Farm."
            },
            "includeTiles": {
              "type": "boolean",
              "description": "List tile positions for each group. Default false."
            }
          },
          "additionalProperties": false
        },
        "annotations": {
          "readOnlyHint": true
        }
      },
      {
        "name": "get_gift_tastes",
        "description": "The gifts a villager loves, likes, dislikes and hates, from the game's data. Universal tastes apply on top of these.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "npc": {
              "type": "string",
              "description": "Villager name, for example Abigail."
            }
          },
          "additionalProperties": false,
          "required": [
            "npc"
          ]
        },
        "annotations": {
          "readOnlyHint": true
        }
      },
      {
        "name": "get_inventory",
        "description": "The farmer's backpack: every slot with item name, id, stack, quality and sell price. Slot 0-11 is the toolbar row.",
        "inputSchema": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "annotations": {
          "readOnlyHint": true
        }
      },
      {
        "name": "get_item_info",
        "description": "Look up an item by name or id: type, category, description, sell price, energy and health if edible. For seeds also the crop's seasons, days to grow and regrowth; for crops, which seed grows them.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "item": {
              "type": "string",
              "description": "Item name (for example 'Parsnip Seeds') or qualified id (for example '(O)472')."
            }
          },
          "additionalProperties": false,
          "required": [
            "item"
          ]
        },
        "annotations": {
          "readOnlyHint": true
        }
      },
      {
        "name": "get_location",
        "description": "Describe a map: size, exits (warps and doors with their target maps), buildings, NPCs and players present, forage, machines and their output, chests (including unopened gift boxes and their contents) and other objects. Defaults to the farmer's current map, so call it without arguments to see where the farmer is standing.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "location": {
              "type": "string",
              "description": "Map name such as Farm, Town, SeedShop, FarmHouse. Omit for the current map."
            },
            "includeObjects": {
              "type": "boolean",
              "description": "Include a list of every placed object with its tile (can be long). Default false."
            }
          },
          "additionalProperties": false
        },
        "annotations": {
          "readOnlyHint": true
        }
      },
      {
        "name": "get_quests",
        "description": "The quest log: each quest's title, description, objectives and days left.",
        "inputSchema": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "annotations": {
          "readOnlyHint": true
        }
      },
      {
        "name": "get_relationships",
        "description": "Every villager the farmer has met: hearts, friendship points, whether talked to today, gifts given today and this week, birthday, relationship status, and current map when known.",
        "inputSchema": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "annotations": {
          "readOnlyHint": true
        }
      },
      {
        "name": "get_shop_stock",
        "description": "What a shop sells today and at what price (does not need the shop to be open). Shops: SeedShop (Pierre), Joja, FishShop (Willy), Blacksmith (Clint), AnimalShop (Marnie), Saloon (Gus), Carpenter (Robin), Hospital.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "shop": {
              "type": "string",
              "description": "Shop id.",
              "enum": [
                "SeedShop",
                "Joja",
                "FishShop",
                "Blacksmith",
                "AnimalShop",
                "Saloon",
                "Carpenter",
                "Hospital"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "shop"
          ]
        },
        "annotations": {
          "readOnlyHint": true
        }
      },
      {
        "name": "get_skills",
        "description": "Skill levels, experience points and professions.",
        "inputSchema": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "annotations": {
          "readOnlyHint": true
        }
      },
      {
        "name": "get_status",
        "description": "Overview of the current moment: whether a save is loaded, date and time, weather, the farmer's money, energy, health, location, tile and held item, and whether the game is in a menu, event or paused. Call this first.",
        "inputSchema": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "annotations": {
          "readOnlyHint": true
        }
      },
      {
        "name": "give_gift",
        "description": "Walk to a villager and give them an item from the backpack. Asks the player first unless they gave standing permission.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "npc": {
              "type": "string",
              "description": "Villager name."
            },
            "item": {
              "type": "string",
              "description": "Item name."
            }
          },
          "additionalProperties": false,
          "required": [
            "npc",
            "item"
          ]
        },
        "annotations": {
          "readOnlyHint": false
        }
      },
      {
        "name": "go_to_bed",
        "description": "Walk home and go to sleep, ending the day (the game saves overnight).",
        "inputSchema": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "annotations": {
          "readOnlyHint": false
        }
      },
      {
        "name": "harvest_crops",
        "description": "Harvest every ready crop on a map (default Farm), optionally only one kind. Stops if the backpack fills up.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "location": {
              "type": "string",
              "description": "Map name. Default Farm."
            },
            "crop": {
              "type": "string",
              "description": "Only harvest this crop, for example Parsnip."
            }
          },
          "additionalProperties": false
        },
        "annotations": {
          "readOnlyHint": false
        }
      },
      {
        "name": "interact",
        "description": "Low-level fallback: walk next to a tile in the current map and press the action button on it (open, pick up, read a sign). Returns any dialogue shown.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "x": {
              "type": "integer",
              "description": "Tile x."
            },
            "y": {
              "type": "integer",
              "description": "Tile y."
            }
          },
          "additionalProperties": false,
          "required": [
            "x",
            "y"
          ]
        },
        "annotations": {
          "readOnlyHint": false
        }
      },
      {
        "name": "plant_seeds",
        "description": "Plant seeds from the backpack: uses empty tilled soil first, otherwise clears weeds, stones and twigs and tills new soil near the farmhouse. Waters them afterwards unless it is raining.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "seeds": {
              "type": "string",
              "description": "Seed item name, for example 'Parsnip Seeds'."
            },
            "count": {
              "type": "integer",
              "description": "How many to plant. Default all of them."
            },
            "location": {
              "type": "string",
              "description": "Map name. Default Farm."
            },
            "water": {
              "type": "boolean",
              "description": "Water after planting. Default true."
            }
          },
          "additionalProperties": false,
          "required": [
            "seeds"
          ]
        },
        "annotations": {
          "readOnlyHint": false
        }
      },
      {
        "name": "read_memory",
        "description": "What you remember about this farm: the standing goal, your notes (goals, the player's preferences, what you learned), today's plan, and summaries of recent days. Also self-play state and today's model budget.",
        "inputSchema": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "annotations": {
          "readOnlyHint": true
        }
      },
      {
        "name": "set_self_play",
        "description": "Start or stop self-play, where you play by yourself toward a standing goal. Only when the player asks. Optionally set the goal in plain language; without one, follow the default first-year checklist.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "true to start, false to stop."
            },
            "goal": {
              "type": "string",
              "description": "Standing goal, for example 'earn 10,000g by summer' or 'finish the spring bundles'."
            }
          },
          "additionalProperties": false,
          "required": [
            "enabled"
          ]
        },
        "annotations": {
          "readOnlyHint": false
        }
      },
      {
        "name": "ship_items",
        "description": "Put items from the backpack into the farm's shipping bin (sold overnight). Always asks the player first unless they gave standing permission. Keeps one of any item a Community Center bundle still needs unless includeBundleItems is true.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "item": {
                    "type": "string",
                    "description": "Item name."
                  },
                  "count": {
                    "type": "integer",
                    "description": "How many. Default all."
                  }
                },
                "additionalProperties": false,
                "required": [
                  "item"
                ]
              },
              "description": "Items to ship."
            },
            "includeBundleItems": {
              "type": "boolean",
              "description": "Also ship items a bundle still needs. Default false."
            }
          },
          "additionalProperties": false,
          "required": [
            "items"
          ]
        },
        "annotations": {
          "readOnlyHint": false
        }
      },
      {
        "name": "stop_autopilot",
        "description": "Stop whatever the autopilot is doing and hand control back to the player.",
        "inputSchema": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "annotations": {
          "readOnlyHint": false
        }
      },
      {
        "name": "store_in_chest",
        "description": "Put items from the backpack into a chest (the nearest one in the map, or the one at x, y).",
        "inputSchema": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "string",
                "description": "Item name."
              },
              "description": "Items to store."
            },
            "allButTools": {
              "type": "boolean",
              "description": "Store everything except tools."
            },
            "location": {
              "type": "string",
              "description": "Map with the chest. Default the current map."
            },
            "x": {
              "type": "integer",
              "description": "Chest tile x."
            },
            "y": {
              "type": "integer",
              "description": "Chest tile y."
            }
          },
          "additionalProperties": false
        },
        "annotations": {
          "readOnlyHint": false
        }
      },
      {
        "name": "take_from_chest",
        "description": "Take an item out of a chest (the nearest one in the map, or the one at x, y).",
        "inputSchema": {
          "type": "object",
          "properties": {
            "item": {
              "type": "string",
              "description": "Item name."
            },
            "count": {
              "type": "integer",
              "description": "How many. Default all."
            },
            "location": {
              "type": "string",
              "description": "Map with the chest. Default the current map."
            },
            "x": {
              "type": "integer",
              "description": "Chest tile x."
            },
            "y": {
              "type": "integer",
              "description": "Chest tile y."
            }
          },
          "additionalProperties": false,
          "required": [
            "item"
          ]
        },
        "annotations": {
          "readOnlyHint": false
        }
      },
      {
        "name": "talk_to",
        "description": "Walk to a villager and talk to them (raises friendship once a day). Returns what they said.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "npc": {
              "type": "string",
              "description": "Villager name."
            }
          },
          "additionalProperties": false,
          "required": [
            "npc"
          ]
        },
        "annotations": {
          "readOnlyHint": false
        }
      },
      {
        "name": "use_tool",
        "description": "Low-level fallback: walk next to a tile in the current map and use a tool on it (Axe, Hoe, Pickaxe, Watering Can, Scythe).",
        "inputSchema": {
          "type": "object",
          "properties": {
            "tool": {
              "type": "string",
              "description": "Tool name."
            },
            "x": {
              "type": "integer",
              "description": "Tile x."
            },
            "y": {
              "type": "integer",
              "description": "Tile y."
            }
          },
          "additionalProperties": false,
          "required": [
            "tool",
            "x",
            "y"
          ]
        },
        "annotations": {
          "readOnlyHint": false
        }
      },
      {
        "name": "walk_to",
        "description": "Walk the farmer to a map, a tile, or next to a villager. Crosses maps using doors and map edges, and respects shop hours. Give location (and optionally x, y), or npc.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "location": {
              "type": "string",
              "description": "Map name, for example Town, SeedShop, Beach, FarmHouse. Defaults to the current map."
            },
            "x": {
              "type": "integer",
              "description": "Tile x in that map."
            },
            "y": {
              "type": "integer",
              "description": "Tile y in that map."
            },
            "npc": {
              "type": "string",
              "description": "Walk next to this villager instead."
            }
          },
          "additionalProperties": false
        },
        "annotations": {
          "readOnlyHint": false
        }
      },
      {
        "name": "water_crops",
        "description": "Water every crop that needs it on a map (default Farm), refilling the watering can at the nearest water when empty. Skips if it is raining there.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "location": {
              "type": "string",
              "description": "Map name. Default Farm."
            }
          },
          "additionalProperties": false
        },
        "annotations": {
          "readOnlyHint": false
        }
      },
      {
        "name": "write_day_plan",
        "description": "Write today's plan: a short ordered list of what to do today and why. The player sees it in the chat and can change it by telling you.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "plan": {
              "type": "string",
              "description": "Short ordered list, one task per line."
            }
          },
          "additionalProperties": false,
          "required": [
            "plan"
          ]
        },
        "annotations": {
          "readOnlyHint": false
        }
      },
      {
        "name": "write_day_summary",
        "description": "Write the summary of today: what got done, money, problems, and what tomorrow should start with. Call it before going to bed.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "summary": {
              "type": "string",
              "description": "A few short lines."
            }
          },
          "additionalProperties": false,
          "required": [
            "summary"
          ]
        },
        "annotations": {
          "readOnlyHint": false
        }
      },
      {
        "name": "write_notes",
        "description": "Replace your notes for this farm (plain text the player can read and edit). Keep what is still true; add what you learned. Saved when the game saves at night.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "description": "The full new notes."
            }
          },
          "additionalProperties": false,
          "required": [
            "text"
          ]
        },
        "annotations": {
          "readOnlyHint": false
        }
      }
    ]
  },
