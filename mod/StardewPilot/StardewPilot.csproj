<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>StardewPilot</AssemblyName>
    <RootNamespace>StardewPilot</RootNamespace>
    <Version>0.1.0</Version>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <EnableHarmony>false</EnableHarmony>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.*" />
    <!-- Newtonsoft.Json ships with SMAPI; reference it without copying. -->
    <Reference Include="Newtonsoft.Json" HintPath="$(GamePath)/smapi-internal/Newtonsoft.Json.dll" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <!-- Ship the pi extension inside the mod so the launcher works without the repo. -->
    <None Include="../../agent/src/*.ts" Link="agent/src/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../agent/package.json" Link="agent/package.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
