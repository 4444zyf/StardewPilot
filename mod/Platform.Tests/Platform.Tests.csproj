<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Compiles the mod's operating-system code (mod/StardewPilot/Platform) and the apprentice's habit rules (Apprentice/Model) without the game, so it can be tested on
    machines that do not have Stardew Valley, such as the Windows machines in CI. Run: dotnet run -project mod/Platform.Tests
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../StardewPilot/Platform/*.cs" Link="Platform/%(Filename)%(Extension)" />
    <Compile Include="../StardewPilot/Apprentice/Model/*.cs" Link="Apprentice/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
